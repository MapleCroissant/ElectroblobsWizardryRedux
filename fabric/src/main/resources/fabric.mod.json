{
  "schemaVersion": 1,
  "id": "ebwizardry",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://electroblobs-redux-wiki.pages.dev/"
  },
  "accessWidener": "ebwizardry.accesswidener",
  "license": "${license}",
  "icon": "assets/ebwizardry/ebwizardry.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.binaris.wizardry.WizardryFabricMod"
    ],
    "client": [
      "com.binaris.wizardry.client.WizardryFabricClient"
    ],
    "cardinal-components": [
      "com.binaris.wizardry.cca.EBComponents"
    ],
    "fabric-datagen": [
      "com.binaris.wizardry.datagen.EBFabricDataGenerators"
    ],
    "fabric-gametest": [
      "com.binaris.wizardry.gametest.ArcaneWorkbenchTest",
      "com.binaris.wizardry.gametest.WandTest",
      "com.binaris.wizardry.gametest.ConjureItemTest",
      "com.binaris.wizardry.gametest.ImbuementEnchantsTest",
      "com.binaris.wizardry.gametest.WizardArmorTest",
      "com.binaris.wizardry.gametest.MigrationTest"
    ]
  },
  "mixins": [
    "ebwizardry.mixins.json",
    "ebwizardry.fabric.mixins.json"
  ],
  "custom": {
    "cardinal-components": [
      "ebwizardry:wizard_data",
      "ebwizardry:summoned_entity_data",
      "ebwizardry:minion_data",
      "ebwizardry:conjure_item",
      "ebwizardry:conjure",
      "ebwizardry:cast_command_data",
      "ebwizardry:spell_manager_data",
      "ebwizardry:imbuement_enchants",
      "ebwizardry:arcane_lock",
      "ebwizardry:containment_data"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "recommends": {
    "accessories": "*",
    "trinkets": "*"
  }
}

